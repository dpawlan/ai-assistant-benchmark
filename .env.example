# Request form delivery (see README > Request form). Optional; without these the route only logs.
GITHUB_TOKEN=
GITHUB_REPO=dpawlan/ai-assistant-benchmark
RESEND_API_KEY=
RESEND_FROM=Assistant Benchmark <onboarding@resend.dev>
REQUEST_TO=davidmpawlan@gmail.com

# Use-case upvotes (Upstash Redis via the Vercel Marketplace). Optional: without these, votes are no-ops and counts show 0.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# TypeSafe (Jev) for semantic judgments. Get a key at typesafe.ai.
TYPESAFE_API_KEY=


# Contribution pilot v2: dedicated private Upstash storage is required.
# Reuse the UPSTASH_REDIS_REST_URL/TOKEN variable names above in this deployment.
# Never put these credentials in the contributor installer or guide.
# Public submission switch. Keep false until the private store is configured.
CONTRIB_ENABLED=false
